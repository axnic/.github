# yaml-language-server: $schema=https://json.schemastore.org/github-workflow.json
#
# =============================================================================
# AI Review — PR-Agent review through OpenRouter
# =============================================================================
# Reviews new pull requests and answers /commands in PR comments from allowed users.
# Uses the OPENROUTER_API_KEY secret (generated by Terraform); does nothing without it.
#
# Jobs:
#   review — PR-Agent review and /commands, from core.review
#
# MANAGED BY TERRAFORM (axnic/.github, terraform/modules/workflows) — do not edit by hand.
# Reusable workflow: https://github.com/axnic/.github/blob/main/.github/workflows/core.review.yaml
# =============================================================================

name: AI Review

on:
  issue_comment:
    types: [created]
  pull_request:
    types: [opened]

# Minimal top-level permissions — each job declares what it needs.
permissions: {}

jobs:
  # ---------------------------------------------------------------------------
  # review — PR-Agent review and /commands, from core.review
  # ---------------------------------------------------------------------------
  review:
    name: 🤖 PR Agent
    # Pinned to the axnic/.github commit that last changed this workflow; Terraform keeps it up to date.
    uses: axnic/.github/.github/workflows/core.review.yaml@${central["core.review"]} # main
    secrets: inherit
    permissions:
      contents: read
      issues: write
      pull-requests: write
%{ if settings.review_model != null || settings.review_fallback_model != null ~}
    with:
%{ if settings.review_fallback_model != null ~}
      fallback-model: ${y.review_fallback_model}
%{ endif ~}
%{ if settings.review_model != null ~}
      model: ${y.review_model}
%{ endif ~}
%{ endif ~}
