# yaml-language-server: $schema=https://json.schemastore.org/github-workflow.json
#
# =============================================================================
# Wiki — Publish docs/ to the GitHub wiki
# =============================================================================
# Mirrors the documentation directory to the repository wiki on every push that
# changes it, and on demand.
#
# Jobs:
#   wiki — mirror the docs directory to the wiki, from wiki.publish
#
# MANAGED BY TERRAFORM (axnic/.github, terraform/modules/workflows) — do not edit by hand.
# Reusable workflow: https://github.com/axnic/.github/blob/main/.github/workflows/wiki.publish.yaml
# =============================================================================

name: Wiki

on:
  push:
    branches: [${default_branch}]
    paths:
      - ${settings.wiki_docs_dir}/**
      - .github/workflows/${caller}
  workflow_dispatch: {}

concurrency:
  group: wiki
  cancel-in-progress: false

# Minimal top-level permissions — each job declares what it needs.
permissions: {}

jobs:
  # ---------------------------------------------------------------------------
  # wiki — mirror the docs directory to the wiki, from wiki.publish
  # ---------------------------------------------------------------------------
  wiki:
    name: 📚 Publish Wiki
    # Pinned to the axnic/.github commit that last changed this workflow; Terraform keeps it up to date.
    uses: axnic/.github/.github/workflows/wiki.publish.yaml@${central["wiki.publish"]} # main
    secrets: inherit
    permissions:
      contents: write
    with:
      docs-dir: ${y.wiki_docs_dir}
