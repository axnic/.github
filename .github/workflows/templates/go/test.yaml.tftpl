# yaml-language-server: $schema=https://json.schemastore.org/github-workflow.json
#
# =============================================================================
# Quality Assurance — Go build, tests and coverage
# =============================================================================
# Builds the Go code, runs the tests and reports coverage when Go files change,
# on pull requests and pushes to the default branch.
# Requires the mise tasks: ci:build, ci:test, ci:coverage.
#
# Jobs:
#   test — Go build, tests and coverage, from go.test
#
# MANAGED BY TERRAFORM (axnic/.github, terraform/modules/workflows) — do not edit by hand.
# Reusable workflow: https://github.com/axnic/.github/blob/main/.github/workflows/go.test.yaml
# =============================================================================

name: Quality Assurance

on:
  pull_request:
    paths:
%{ for p in concat(settings.go_paths, [".github/workflows/${caller}"]) ~}
      - ${startswith(p, "*") ? jsonencode(p) : p}
%{ endfor ~}
  push:
    branches: [${default_branch}]
    paths:
%{ for p in concat(settings.go_paths, [".github/workflows/${caller}"]) ~}
      - ${startswith(p, "*") ? jsonencode(p) : p}
%{ endfor ~}

concurrency:
  group: test-$${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

# Minimal top-level permissions — each job declares what it needs.
permissions: {}

jobs:
  # ---------------------------------------------------------------------------
  # test — Go build, tests and coverage, from go.test
  # ---------------------------------------------------------------------------
  test:
    name: 🧪 Go
    # Pinned to the axnic/.github commit that last changed this workflow; Terraform keeps it up to date.
    uses: axnic/.github/.github/workflows/go.test.yaml@${central["go.test"]} # main
    secrets: inherit
    permissions:
      contents: read
%{ if settings.go_os != null ~}
    with:
      os: ${jsonencode(jsonencode(settings.go_os))}
%{ endif ~}
