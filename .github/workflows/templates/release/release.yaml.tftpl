# yaml-language-server: $schema=https://json.schemastore.org/github-workflow.json
#
# =============================================================================
# Release — Create a versioned release from the GitHub UI
# =============================================================================
# Triggered manually (Actions → Release → Run workflow). Set either `bump` or `version`,
# not both. prepare runs `mise run ci`, computes the version, writes the notes and pushes
# the tag; ${publish_text}.
# Requires the mise task: ci${contains(publishes, "nodejs") || contains(publishes, "argocd-extension") ? ", ci:build" : ""}.
#
# Jobs:
#   prepare — run `mise run ci`, compute the version, write the notes, push the tag
${publish_header}
#
# MANAGED BY TERRAFORM (axnic/.github, terraform/modules/workflows) — do not edit by hand.
# Reusable workflow: https://github.com/axnic/.github/blob/main/.github/workflows/release.prepare.yaml
# =============================================================================

name: Release

on:
  workflow_dispatch:
    inputs:
      bump:
        description: Version bump (choose `manual` to release the exact `version` below)
        required: false
        type: choice
        default: auto
        options:
          - auto
          - patch
          - minor
          - major
          - manual
      version:
        description: Exact version to release, without the leading "v" (only with the `manual` bump)
        required: false
        type: string
      notes:
        description: Release notes override (leave empty to generate them)
        required: false
        type: string

concurrency:
  group: release
  cancel-in-progress: false

# Minimal top-level permissions — each job declares what it needs.
permissions: {}

jobs:
  # ---------------------------------------------------------------------------
  # prepare — run `mise run ci`, compute the version, write the notes, push the tag
  # ---------------------------------------------------------------------------
  prepare:
    name: 🏷️ Prepare
    # Pinned to the axnic/.github commit that last changed this workflow; Terraform keeps it up to date.
    uses: axnic/.github/.github/workflows/release.prepare.yaml@${central["release.prepare"]} # main
    secrets: inherit
    permissions:
      contents: write
      pull-requests: read
    with:
      # `manual` is not a bump: the reusable workflow gets an empty bump and the exact `version`.
      bump: "$${{ inputs.bump != 'manual' && inputs.bump || '' }}"
      notes: "$${{ inputs.notes }}"
      version: "$${{ inputs.version }}"

%{ if publish_jobs != "" ~}
${publish_jobs}
%{ endif ~}
%{ if contains(publishes, "go") ~}
%{ if publish_jobs != "" ~}

%{ endif ~}
  # ---------------------------------------------------------------------------
  # publish — build the artifacts of the draft GitHub Release, from go.publish
  # ---------------------------------------------------------------------------
  publish:
    name: 🚀 Publish
    needs: prepare
    # Pinned to the axnic/.github commit that last changed this workflow; Terraform keeps it up to date.
    uses: axnic/.github/.github/workflows/go.publish.yaml@${central["go.publish"]} # main
    secrets: inherit
    permissions:
      attestations: write
      contents: write
      id-token: write
    with:
      tag: "$${{ needs.prepare.outputs.tag }}"
      version: "$${{ needs.prepare.outputs.version }}"
      prerelease: "$${{ needs.prepare.outputs.prerelease == 'true' }}"
%{ endif ~}
