%{ if length(pi_extensions) > 0 ~}
## π｜Pi-agent Extensions

Standalone modules that extend pi-agent's capabilities — each ships as an independent, installable package.

%{ for p in pi_extensions ~}
- [${p.archived ? "~~${p.name}~~" : "**${p.name}**"}](${p.url})%{ if p.description != "" } — ${p.archived ? "~~${p.description}~~" : p.description}%{ endif }\
    ${join(" ", slice(p.badges, 0, ceil(length(p.badges) / 2)))}\
    ${join(" ", slice(p.badges, ceil(length(p.badges) / 2), length(p.badges)))}

%{ endfor ~}

%{ endif ~}

%{ if length(pulumi) > 0 ~}
## Pulumi Providers

Pulumi providers for self-hosted services.

%{ for p in pulumi ~}
- [${p.archived ? "~~${p.name}~~" : "**${p.name}**"}](${p.url})%{ if p.description != "" } — ${p.archived ? "~~${p.description}~~" : p.description}%{ endif }\
    ${join(" ", slice(p.badges, 0, ceil(length(p.badges) / 2)))}\
    ${join(" ", slice(p.badges, ceil(length(p.badges) / 2), length(p.badges)))}

%{ endfor ~}

%{ endif ~}

%{ if length(others) > 0 ~}
## Other Projects

